OPENAI_API_KEY=sk-...

# SMTP (Gmail) - use an App Password for SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@onlinejobs.my
SMTP_PASSWORD=your-16-char-app-password

# Visible "From" header (must be a registered send-as alias on SMTP_USER's account)
FROM_ALIAS=javed@onlinejobs.my
FROM_DISPLAY_NAME=VASU YARANIAN

# Optional: full path to the company profile PDF to attach to every email
ATTACHMENT_PATH=AP_ONLINE_JOBS_COMPANY_PROFILE.pdf

DAILY_CAP=20
MIN_GAP_SECONDS=90
TIMEZONE=Asia/Kuala_Lumpur
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
