OPENAI_API_KEY=sk-...

# SMTP (Gmail) - use an App Password for SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@atlasprobookkeeping.ie
SMTP_PASSWORD=your-16-char-app-password

# Visible "From" header (must be a registered send-as alias on SMTP_USER's account)
FROM_ALIAS=admin@atlasprobookkeeping.ie
FROM_DISPLAY_NAME=Atlas Professional Bookkeeping

# Optional: full path to the company profile PDF to attach to every email
ATTACHMENT_PATH=ATLAS_COMPANY_PROFILE.pdf

# Email signature (shown in both the plain-text and HTML version of every email)
SIGNATURE_NAME=Stephen Darby
SIGNATURE_TITLE=
SIGNATURE_COMPANY=Atlas Professional Bookkeeping
SIGNATURE_EMAIL=info@atlasprobookkeeping.ie
SIGNATURE_PHONE=
SIGNATURE_WEBSITE=https://www.atlasprobookkeeping.ie/
# Optional: logo image embedded below the signature in the HTML email (skipped if missing)
SIGNATURE_LOGO_PATH=signature_logo.png

DAILY_CAP=50
MIN_GAP_SECONDS=90
TIMEZONE=Europe/Dublin
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
